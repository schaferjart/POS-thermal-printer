# Portrait renderer environment. Set these in Coolify, never commit real values.

# OpenRouter key for the wax image model (model id is in config.yaml).
OPENROUTER_API_KEY=sk-or-...

# Supabase project URL and its PUBLISHABLE key (sb_publishable_...), the same
# pair the printers use. Only used to call printer.check_device.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
