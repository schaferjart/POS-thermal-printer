# Copy to /etc/printer/printer.env on the printer (install.sh does this when
# PRINTER_CLOUD_URL and PRINTER_CLOUD_KEY are set). Leave it out to run the
# printer without a cloud: AirPrint and the print page still work.
#
# Your Supabase project URL and its publishable key (sb_publishable_...).
# The key is meant for clients: it can only call the printer.* functions.
PRINTER_CLOUD_URL=https://<project-ref>.supabase.co
PRINTER_CLOUD_KEY=sb_publishable_...
