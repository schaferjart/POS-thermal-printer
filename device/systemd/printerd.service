[Unit]
Description=Thermal printer service (print page, cloud jobs -> CUPS)
After=network-online.target cups.service
Wants=network-online.target

[Service]
ExecStart=/opt/printer/.venv/bin/python /opt/printer/device/printerd.py
# Your cloud (not in the repo): PRINTER_CLOUD_URL / PRINTER_CLOUD_KEY
EnvironmentFile=-/etc/printer/printer.env
WorkingDirectory=/opt/printer/device
# Own throwaway user; the device token lives in /var/lib/printer.
DynamicUser=yes
StateDirectory=printer
StateDirectoryMode=0700
Restart=always
RestartSec=5
MemoryMax=200M
# Port 80 for the page (http://print.local) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
